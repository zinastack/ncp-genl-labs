# Tasks 2 and 3 edit THIS file. After each change: make reload-07 M=text_classifier, then make perf-07.
name: "text_classifier"
backend: "python"
max_batch_size: 16

input [
  { name: "TEXT" data_type: TYPE_STRING dims: [ 1 ] }
]
output [
  { name: "LABEL" data_type: TYPE_STRING dims: [ 1 ] },
  { name: "SCORE" data_type: TYPE_FP32 dims: [ 1 ] }
]

dynamic_batching {
  preferred_batch_size: [ 4, 8 ]
  max_queue_delay_microseconds: 2000
}

instance_group [ { count: 1 kind: KIND_GPU } ]

version_policy: { latest: { num_versions: 1 } }
