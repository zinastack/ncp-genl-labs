# The same DistilBERT, exported to ONNX (make export-onnx) and run by the ONNX Runtime backend.
# Inputs are token ids: the tokenizer runs in the client or in the ensemble (task 5).
name: "distilbert_onnx"
backend: "onnxruntime"
max_batch_size: 16

input [
  { name: "input_ids" data_type: TYPE_INT32 dims: [ -1 ] },
  { name: "attention_mask" data_type: TYPE_INT32 dims: [ -1 ] }
]
output [
  { name: "logits" data_type: TYPE_FP32 dims: [ 2 ] }
]

dynamic_batching { max_queue_delay_microseconds: 1000 }
instance_group [ { count: 1 kind: KIND_GPU } ]

# Task 4c: uncomment to let ONNX Runtime hand the graph to TensorRT (FP16) without building an
# engine yourself. The first load gets slower (TensorRT builds the engine inside Triton).
# optimization { execution_accelerators {
#   gpu_execution_accelerator : [ {
#     name : "tensorrt"
#     parameters { key: "precision_mode" value: "FP16" }
#     parameters { key: "max_workspace_size_bytes" value: "1073741824" }
#   } ]
# } }

# Task 6: serve versions 1 AND 2 side by side (make version2-07 creates 2/), or pin one:
#   version_policy: { all: {} }
#   version_policy: { specific: { versions: [ 1 ] } }
version_policy: { latest: { num_versions: 1 } }
