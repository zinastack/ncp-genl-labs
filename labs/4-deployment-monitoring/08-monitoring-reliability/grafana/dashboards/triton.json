{
  "title": "Triton inference (GENL Lab 08)",
  "uid": "genl-triton",
  "schemaVersion": 39,
  "refresh": "5s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Requests / s",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (model) (rate(nv_inference_request_success[1m]))",
          "legendFormat": "{{model}}{{gpu}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Avg queue time (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "triton:avg_queue_ms",
          "legendFormat": "{{model}}{{gpu}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Avg compute time (ms)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "triton:avg_compute_ms",
          "legendFormat": "{{model}}{{gpu}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Avg dynamic batch size",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "triton:avg_batch_size",
          "legendFormat": "{{model}}{{gpu}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Error ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "triton:error_ratio",
          "legendFormat": "{{model}}{{gpu}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "GPU utilisation (%)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_GPU_UTIL",
          "legendFormat": "{{model}}{{gpu}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "GPU memory used (MiB)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "decmbytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_FB_USED",
          "legendFormat": "{{model}}{{gpu}}"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "GPU power (W)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "watt"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "DCGM_FI_DEV_POWER_USAGE",
          "legendFormat": "{{model}}{{gpu}}"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Request latency P50 / P95 / P99 (ms, Triton summary)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "nv_inference_request_summary_us{quantile=~\"0.5|0.95|0.99\"} / 1000",
          "legendFormat": "{{model}} q{{quantile}}",
          "refId": "A",
          "datasource": null
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Pending requests (waiting for an instance)",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (model) (nv_inference_pending_request_count)",
          "legendFormat": "{{model}}",
          "refId": "A",
          "datasource": null
        }
      ]
    }
  ]
}